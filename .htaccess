# ======================================================================
# BASIC RULES
# ======================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (301 permanent)
  RewriteCond %{HTTP_HOST} ^www\.labzenix\.com [NC]
  RewriteRule ^(.*)$ https://labzenix.com/$1 [L,R=301]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# ======================================================================
# SECURITY HEADERS
# ======================================================================

<IfModule mod_headers.c>
  # Force HTTPS for 1 year — tells browsers to never use HTTP again
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent this site from being embedded in iframes on other domains (anti-clickjacking)
  Header always set X-Frame-Options "DENY"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS filtering (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"

  # Control referrer info sent with requests
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser features / sensors
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Hide server technology info
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ======================================================================
# FILE & DIRECTORY PROTECTION
# ======================================================================

# Block access to sensitive files
<FilesMatch "(^\.env|\.git|\.htaccess|\.htpasswd|package\.json|package-lock\.json|next\.config\.ts|tsconfig\.json|\.sh$)">
  Require all denied
</FilesMatch>

# Block access to hidden dot-files (e.g. .git, .env, .DS_Store)
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\." - [F]
</IfModule>

# ======================================================================
# MALICIOUS REQUEST BLOCKING
# ======================================================================

# Block bad bots, scrapers, and spam traffic
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} ^.*(Baiduspider|YandexBot|AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|MegaIndex|Nikto|sqlmap|masscan|zgrab).*$ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# Block malicious query strings (SQL injection / XSS attempts)
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table) [NC]
  RewriteRule .* - [F,L]

  RewriteCond %{QUERY_STRING} (<script|javascript:|vbscript:|onload=|onerror=) [NC]
  RewriteRule .* - [F,L]

  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e/) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# Block requests with no User-Agent (automated scanners)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} ^-?$ [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ======================================================================
# HOTLINK PROTECTION (saves bandwidth)
# ======================================================================

<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https://(www\.)?labzenix\.com [NC]
  RewriteRule \.(jpg|jpeg|png|gif|webp|svg|pdf)$ - [F,L]
</IfModule>

# ======================================================================
# PERFORMANCE RULES (Caching & Compression)
# ======================================================================

<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # CSS and JS (Aggressive caching)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images and Media
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
